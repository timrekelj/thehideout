# thehideout production configuration.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# NEVER commit .env.production. It is read by `docker compose --env-file`, which
# passes each service only the variables it needs (the server never sees the Scylla
# superuser password). Variables are marked [required] or [optional].
# Generate secrets with:  openssl rand -hex 32
# (Scylla credentials and the S3 secret may only contain letters, digits and _.@+=-,
# which hex satisfies.)

# --- Domains / TLS --------------------------------------------------------------

# [required] Public host of the app. DNS A/AAAA must point at this server. It is
# also the passkey (WebAuthn) relying party id, so it can't change later without
# invalidating passkeys. Server gets THEHIDEOUT_PUBLIC_URL=https://<this> from compose.
THEHIDEOUT_DOMAIN=hideout.example.com
# [required] Host for LiveKit signalling (wss://). DNS A/AAAA to the same server.
LIVEKIT_DOMAIN=voice.example.com
# [required] Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com
# [optional] Image tag of the server build. Default latest.
# THEHIDEOUT_VERSION=latest

# --- ScyllaDB ---------------------------------------------------------------------

# [required] Password of the built-in `cassandra` superuser (replaced on first boot
# by the scylla-init service). Needed for backups and admin. # secret: openssl rand -hex 32
SCYLLA_SUPERUSER_PASSWORD=
# [optional] Application role the server connects as. Default thehideout.
THEHIDEOUT_SCYLLA_USERNAME=thehideout
# [required] Password of that role. # secret: openssl rand -hex 32
THEHIDEOUT_SCYLLA_PASSWORD=
# [optional] CPU shards and memory for Scylla. Defaults 2 / 2G suit a 4 GB, 2 vCPU
# VPS; give it more on bigger machines (Scylla wants about 1 GB per shard minimum).
SCYLLA_SMP=2
SCYLLA_MEMORY=2G
# [optional] 1 (default) on shared / virtualised hosts; 0 only on dedicated hardware.
SCYLLA_OVERPROVISIONED=1
# [optional] Set 1 only if Scylla refuses to start for lack of host tuning (small
# VPS, Docker Desktop). Not recommended for real production.
SCYLLA_DEVELOPER_MODE=0
# [optional] Keyspace (also read by the backup scripts). Default thehideout.
THEHIDEOUT_KEYSPACE=thehideout
# [optional] Keyspace replication used when the server creates it. Default
# SimpleStrategy:1 (single node).
# THEHIDEOUT_SCYLLA_REPLICATION=SimpleStrategy:1

# --- Server -----------------------------------------------------------------------

# [required] Email that receives the first site-admin invite on an empty install.
THEHIDEOUT_BOOTSTRAP_ADMIN_EMAIL=you@example.com
# [required] Contact address shown on the privacy notice and terms (/privacy, /terms):
# where people send export, deletion and data questions. The server refuses to start without it.
THEHIDEOUT_CONTACT_EMAIL=privacy@example.com
# [optional] Who runs this server, as shown on the privacy notice and terms.
THEHIDEOUT_OPERATOR_NAME=
# [optional] Oldest app version the server accepts (semver, e.g. 1.2.0). Older apps get an
# "Update required" screen. Unset = no check. Per-platform overrides (DESKTOP, IOS, ANDROID)
# win over the general value for that platform. Browsers and curl send no version and pass.
THEHIDEOUT_MIN_CLIENT_VERSION=
THEHIDEOUT_MIN_CLIENT_VERSION_DESKTOP=
THEHIDEOUT_MIN_CLIENT_VERSION_IOS=
THEHIDEOUT_MIN_CLIENT_VERSION_ANDROID=
# [optional] Usernames promoted to site admin at startup.
THEHIDEOUT_ADMINS=
# [optional] Log filter. Logs are JSON in production.
RUST_LOG=info
# [optional] Link embeds on/off, and a contact in the embed fetcher's user agent.
THEHIDEOUT_EMBEDS=on
THEHIDEOUT_EMBEDS_CONTACT=
# [optional] Largest upload in bytes (default 50 MiB; Caddy's body limit is 60 MB,
# raise both together).
# THEHIDEOUT_MAX_UPLOAD_BYTES=52428800
# [optional] The proxy network the server trusts for X-Forwarded-For. Compose pins
# the `edge` network to this subnet; change both only on a clash with your host network.
EDGE_SUBNET=172.28.0.0/24

# --- Email (Resend) ---------------------------------------------------------------

# [required] Resend API key. # secret: create at https://resend.com/api-keys
THEHIDEOUT_RESEND_API_KEY=
# [required] Sender; its domain must be verified in Resend (see README: SPF/DKIM/DMARC).
THEHIDEOUT_EMAIL_FROM="thehideout <noreply@hideout.example.com>"

# --- Object storage (S3) ----------------------------------------------------------
# [required] Either an external provider (recommended) or the bundled SeaweedFS.
# The server refuses the built-in dev keys on a real domain.
#
# A) External provider (AWS S3, Cloudflare R2, Backblaze B2, ...): private bucket,
#    key limited to it. Examples:
#      R2:   endpoint https://<account>.r2.cloudflarestorage.com, region auto, path-style true
#      B2:   endpoint https://s3.us-west-004.backblazeb2.com, its region, path-style true
#      AWS:  endpoint https://s3.<region>.amazonaws.com, that region, path-style false
THEHIDEOUT_S3_ENDPOINT=https://s3.example.com
THEHIDEOUT_S3_REGION=auto
THEHIDEOUT_S3_BUCKET=thehideout-media
THEHIDEOUT_S3_ACCESS_KEY=
# secret
THEHIDEOUT_S3_SECRET_KEY=
THEHIDEOUT_S3_PATH_STYLE=true
#
# B) Bundled SeaweedFS (data stays on this machine, in the seaweedfs-data volume):
#    start with `--profile seaweedfs`, set
#      THEHIDEOUT_S3_ENDPOINT=http://seaweedfs:8333
#      THEHIDEOUT_S3_REGION=us-east-1
#      THEHIDEOUT_S3_PATH_STYLE=true
#    and generate a NEW key pair (not the dev values):
#      THEHIDEOUT_S3_ACCESS_KEY=$(openssl rand -hex 12)
#      THEHIDEOUT_S3_SECRET_KEY=$(openssl rand -hex 32)
# The bucket is created automatically for B; create it yourself for A.

# --- Voice (LiveKit) --------------------------------------------------------------

# [required] API key name and secret. The server refuses the dev values and any
# secret under 32 characters. # secret: LIVEKIT_API_SECRET=$(openssl rand -hex 32)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# [optional] Host used for the TURN server. Default LIVEKIT_DOMAIN. Needs a DNS record.
# LIVEKIT_TURN_DOMAIN=turn.example.com
# [optional] UDP media port range, published by compose and set in livekit.yaml.
# Each port costs one docker-proxy process, so keep it small (about 2 ports per
# participant). Default 50000-50100.
# LIVEKIT_UDP_START=50000
# LIVEKIT_UDP_END=50100

# --- Backups (used by backup/backup.sh and restore.sh, not by compose) --------------

# [optional] Where archives go and how many to keep. Defaults ./backups and 14.
# BACKUP_DIR=/var/backups/thehideout
# BACKUP_KEEP=14
# [optional] How to back up media: `rclone` (default, run via docker), `aws` (host
# aws cli), `none` (provider-side versioning/replication instead).
# BACKUP_S3_MODE=rclone
# [optional] Destination rclone remote:path or s3:// URL for a second copy of the
# bucket. Empty = mirror into the archive directory.
# BACKUP_S3_DEST=

# --- Push notifications (optional) ------------------------------------------------
# Notifications for the mobile apps; leave empty to keep push off. See README, "Push
# notifications". Compose passes these values as text, so put the key itself (not a
# path) here: PEM on one line with \n for newlines, the service account JSON on one line.
# [optional] APNs (iOS): the .p8 key text, its Key ID and the Apple Team ID.
# THEHIDEOUT_APNS_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
# THEHIDEOUT_APNS_KEY_ID=
# THEHIDEOUT_APNS_TEAM_ID=
# THEHIDEOUT_APNS_TOPIC=si.zabit.thehideout
# THEHIDEOUT_APNS_SANDBOX=false
# [optional] FCM (Android): the service-account JSON.
# THEHIDEOUT_FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
