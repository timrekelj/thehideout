# Environment for deploy/dokploy/docker-compose.yml.
# Paste into the Environment tab of the Compose service in Dokploy. NEVER commit
# real values. Variables marked "# secret" must be replaced with generated values:
#   openssl rand -hex 16   # LIVEKIT_API_KEY
#   openssl rand -hex 32   # LIVEKIT_API_SECRET (64 chars; LiveKit needs 32+)
# Use hex output only: the LiveKit values are written into a YAML config file.
# The S3 values come from Cloudflare R2, not from openssl.
# There is no ACME_EMAIL here: Let's Encrypt is configured in Dokploy.

# --- Domains --------------------------------------------------------------
# API, web pages and media. Public URL is https://<this>. Add this domain in
# Dokploy's Domains tab for service `server`, port 8080.
THEHIDEOUT_DOMAIN=thehideout.zabit.si
# LiveKit signalling (clients connect to wss://<this>). Add this domain in
# Dokploy's Domains tab for service `livekit`, port 7880.
LIVEKIT_DOMAIN=voice.thehideout.zabit.si

# --- Image ----------------------------------------------------------------
# Server image tag: latest, a release such as 1.2.3, or sha-<commit>.
THEHIDEOUT_VERSION=latest

# --- Email (Resend) -------------------------------------------------------
# Resend API key. # secret
THEHIDEOUT_RESEND_API_KEY=re_change_me
# Sender; the domain must be verified in Resend.
THEHIDEOUT_EMAIL_FROM="thehideout <noreply@thehideout.zabit.si>"
# On an empty install the server invites this address as site admin at startup
# and emails the invite. Optional; the invite CLI works at any time.
THEHIDEOUT_BOOTSTRAP_ADMIN_EMAIL=

# --- Object storage (Cloudflare R2) ---------------------------------------
# See deploy/README.md "R2 setup". All of these come from the Cloudflare dashboard.
# S3 endpoint of your account: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# (R2 > Overview > Account details > S3 API). Do not include the bucket name.
THEHIDEOUT_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Bucket name (R2 > Buckets). Must already exist; the stack does not create it.
THEHIDEOUT_S3_BUCKET=thehideout-media
# R2 uses the region "auto".
THEHIDEOUT_S3_REGION=auto
# Path-style addressing; R2 accepts it.
THEHIDEOUT_S3_PATH_STYLE=true
# Access Key ID of an R2 API token (Object Read & Write, scoped to the bucket). # secret
THEHIDEOUT_S3_ACCESS_KEY=change-me-r2-access-key-id
# Secret Access Key of that token (shown once when the token is created). # secret
THEHIDEOUT_S3_SECRET_KEY=change-me-r2-secret-access-key

# --- Voice (LiveKit) ------------------------------------------------------
# API key. # secret
LIVEKIT_API_KEY=change-me-openssl-rand-hex-16
# API secret, at least 32 characters. # secret
LIVEKIT_API_SECRET=change-me-openssl-rand-hex-32-must-be-32-or-more-chars

# --- Legal pages and version gate -----------------------------------------
# Contact address shown on /privacy and /terms. Required.
THEHIDEOUT_CONTACT_EMAIL=privacy@example.com
# Operator name shown on those pages (optional).
THEHIDEOUT_OPERATOR_NAME=
# Clients older than this must update. Empty = no gate; per-platform overrides
# are THEHIDEOUT_MIN_CLIENT_VERSION_{DESKTOP,IOS,ANDROID}.
THEHIDEOUT_MIN_CLIENT_VERSION=
THEHIDEOUT_MIN_CLIENT_VERSION_DESKTOP=
THEHIDEOUT_MIN_CLIENT_VERSION_IOS=
THEHIDEOUT_MIN_CLIENT_VERSION_ANDROID=

# --- Push notifications (all optional; empty = provider off) --------------
# APNs (iOS): the .p8 key contents (newlines as \n), key id, team id, bundle id.
THEHIDEOUT_APNS_KEY=
THEHIDEOUT_APNS_KEY_ID=
THEHIDEOUT_APNS_TEAM_ID=
THEHIDEOUT_APNS_TOPIC=
THEHIDEOUT_APNS_SANDBOX=false
# FCM (Android): the Firebase service-account JSON, on one line.
THEHIDEOUT_FCM_SERVICE_ACCOUNT=

# --- ScyllaDB -------------------------------------------------------------
# Scylla runs with PasswordAuthenticator. The scylla-init service creates the
# application role below and replaces the default cassandra/cassandra password.
# Letters, digits and _.@+=- only: use hex. Rotate by changing and redeploying.
#   openssl rand -hex 32
# Superuser password. # secret
SCYLLA_SUPERUSER_PASSWORD=change-me-openssl-rand-hex-32
# Application role the server logs in as.
THEHIDEOUT_SCYLLA_USERNAME=thehideout
# Its password. # secret
THEHIDEOUT_SCYLLA_PASSWORD=change-me-openssl-rand-hex-32
# Sizing. Keep memory well below the server RAM (Dokploy and Traefik run on it too).
# CPU cores and memory Scylla may use. Keep memory well below the server RAM
# (Dokploy and Traefik run on it too).
SCYLLA_SMP=1
SCYLLA_MEMORY=1G
# 1 skips the host I/O tuning checks (needed on most VPSes); 0 on a tuned host.
SCYLLA_DEVELOPER_MODE=1
# Only used when the keyspace is first created.
# THEHIDEOUT_SCYLLA_REPLICATION=SimpleStrategy:1

# --- Server tuning (all optional) -----------------------------------------
# Reverse proxies whose X-Forwarded-For is trusted: Traefik's address or subnet
# on the Docker network (see README). Empty trusts none, and every request then
# looks like it comes from Traefik.
THEHIDEOUT_TRUSTED_PROXIES=
THEHIDEOUT_LOG_FORMAT=json
THEHIDEOUT_KEYSPACE=thehideout
THEHIDEOUT_HEARTBEAT_SECS=30
# Largest attachment upload in bytes (default 50 MiB).
THEHIDEOUT_MAX_UPLOAD_BYTES=52428800
# Comma-separated usernames promoted to site admin (re-applied every start).
THEHIDEOUT_ADMINS=
RUST_LOG=info
# Link embeds: on or off.
THEHIDEOUT_EMBEDS=on
THEHIDEOUT_EMBEDS_CONTACT=
THEHIDEOUT_EMBED_MAX_VIDEO_BYTES=52428800
# JSON object overriding embed mirrors; see the root .env.example. Leave empty for defaults.
THEHIDEOUT_EMBED_MIRRORS=
# Public base URL if the bucket is served publicly (optional; see the root .env.example).
# THEHIDEOUT_S3_PUBLIC_BASE=
