# thehideout configuration template.
#
# Copy to `.env` (`cp .env.example .env`) and edit. NEVER commit `.env`.
# Real environment variables override values in `.env`.
# Values below are the local-dev defaults (see server/src/config.rs and
# docker-compose.yml). Variables marked `# secret` must be filled in by you.

# --- Server ---------------------------------------------------------------

# Address the server binds to. Default 0.0.0.0:8080.
THEHIDEOUT_LISTEN_ADDR=0.0.0.0:8080
# Comma-separated ScyllaDB contact points. Default 127.0.0.1:9042.
THEHIDEOUT_SCYLLA_NODES=127.0.0.1:9042
# ScyllaDB keyspace. Default thehideout.
THEHIDEOUT_KEYSPACE=thehideout
# Snowflake worker id, unique per running server instance (u16). Default 0.
THEHIDEOUT_WORKER_ID=0
# Seconds between heartbeats, at least 1. Default 30.
THEHIDEOUT_HEARTBEAT_SECS=30
# Largest attachment upload in bytes. Default 52428800 (50 MiB).
THEHIDEOUT_MAX_UPLOAD_BYTES=52428800
# Comma-separated usernames promoted to site admin at startup (if the account
# exists) and when the account is created (accepting an invite). Re-applied on
# every start. A secondary mechanism: admin invites are the primary one.
# Optional, e.g. THEHIDEOUT_ADMINS=alice,bob
THEHIDEOUT_ADMINS=
# Log filter (tracing EnvFilter syntax), e.g. info or thehideout_server=debug.
RUST_LOG=info

# --- Link embeds ----------------------------------------------------------

# Fetch link previews for URLs in messages: on or off. Default on.
THEHIDEOUT_EMBEDS=on
# Contact (URL or mailto:) shown in the embed fetcher's user agent. Optional.
THEHIDEOUT_EMBEDS_CONTACT=
# Largest video stored for X/TikTok/Instagram/Reddit embeds, in bytes. A bigger
# one is not stored (the embed keeps its poster and link). Default 52428800 (50 MiB).
THEHIDEOUT_EMBED_MAX_VIDEO_BYTES=52428800
# Override the embed-friendly mirrors/APIs the provider embeds are fetched from,
# as a JSON object of role -> list of base URLs tried in order. Roles: x_api,
# x_vx_api, x_html, tiktok, instagram, reddit, reddit_json. Roles you leave out
# keep their defaults. Mirrors are only used for fetching; messages keep the
# original link. Optional, e.g.:
# THEHIDEOUT_EMBED_MIRRORS={"tiktok":["https://tnktok.com"],"instagram":["https://uuinstagram.com","https://vxinstagram.com"]}

# --- Object storage (S3-compatible) ---------------------------------------
# Defaults match the local SeaweedFS service in docker-compose.yml. The dev
# credentials are local-only; never reuse them anywhere reachable.

# S3 API endpoint. Default http://127.0.0.1:8333.
THEHIDEOUT_S3_ENDPOINT=http://127.0.0.1:8333
# Signing region. Default us-east-1 (use the provider's region, or auto for R2).
THEHIDEOUT_S3_REGION=us-east-1
# Bucket name; must exist. Default thehideout-media.
THEHIDEOUT_S3_BUCKET=thehideout-media
# Access key id. Dev default thehideout-dev. Use a bucket-scoped key in production.
THEHIDEOUT_S3_ACCESS_KEY=thehideout-dev
# Secret key. Dev default thehideout-dev-secret. # secret
THEHIDEOUT_S3_SECRET_KEY=thehideout-dev-secret
# Path-style addressing (endpoint/bucket/key): true or false. Default true;
# set false for AWS S3 and other virtual-hosted providers.
THEHIDEOUT_S3_PATH_STYLE=true
# Reserved for a CDN or public bucket URL in front of /media (only logged today).
THEHIDEOUT_S3_PUBLIC_BASE=

# --- Desktop client -------------------------------------------------------

# Server the desktop app connects to. Default http://127.0.0.1:8080.
# THEHIDEOUT_SERVER_URL=http://127.0.0.1:8080

# --- Auth, invites and email ----------------------------------------------
# Accounts are invite-only (see README "Accounts, invites and email").

# Public base URL used in invite links and as the passkey (WebAuthn) origin;
# its host is the passkey relying party id and must be a domain name (not an IP).
# Default http://localhost:<port of THEHIDEOUT_LISTEN_ADDR>.
# Production example: https://thehideout.zabit.si
THEHIDEOUT_PUBLIC_URL=
# Sender of outgoing mail. Default "thehideout <noreply@thehideout.zabit.si>".
THEHIDEOUT_EMAIL_FROM="thehideout <noreply@thehideout.zabit.si>"
# Resend API key. When empty, mail goes to the SMTP server below. # secret
# Dev safety: the key is ignored (mail goes to SMTP/Mailpit, with a warning at
# startup) while THEHIDEOUT_PUBLIC_URL's host is localhost, *.localhost, *.test,
# *.example or an IP address, unless THEHIDEOUT_EMAIL_FORCE_RESEND=true. Mail to
# reserved test domains (example.com/.net/.org, *.test, *.example, *.invalid,
# localhost) is never sent through Resend: it is logged and dropped.
THEHIDEOUT_RESEND_API_KEY=
# Use Resend even for a development THEHIDEOUT_PUBLIC_URL: true or false.
# Default false.
THEHIDEOUT_EMAIL_FORCE_RESEND=false
# Plain SMTP (no TLS, no auth) used when no Resend key is set: the local Mailpit
# from docker-compose.yml (web inbox at http://127.0.0.1:8025).
# Default smtp://127.0.0.1:1025.
THEHIDEOUT_SMTP_URL=smtp://127.0.0.1:1025
# On an install with no accounts, the server invites this address as site admin
# at startup and logs the code. Optional; `thehideout-server invite <email> --admin`
# works at any time.
THEHIDEOUT_BOOTSTRAP_ADMIN_EMAIL=

# --- Voice channels (LiveKit) ---------------------------------------------
# A self-hosted LiveKit SFU carries voice/video; the server issues join tokens
# and tracks who is in which channel. Set LIVEKIT_URL, LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET together to enable it; leave all empty to disable voice
# (voice channels still list, JoinVoice answers UNAVAILABLE). Defaults match
# the `livekit` service in docker-compose.yml. LiveKit must also be configured
# to POST webhooks to <server>/livekit/webhook, signed with the same key/secret.
# URL clients connect to (ws:// or wss://), e.g. wss://voice.example.com
LIVEKIT_URL=ws://127.0.0.1:7880
# URL the server calls LiveKit's API on (http:// or https://). Optional; default
# is LIVEKIT_URL with ws -> http and wss -> https.
LIVEKIT_API_URL=
# API key and secret. The dev values below are public: the server refuses to
# start with the key `devkey`, the secret `secret` or any secret shorter than 32
# characters unless THEHIDEOUT_PUBLIC_URL is a development host (localhost, an IP,
# *.test, *.example). Use a real key and a 32+ character secret elsewhere.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
